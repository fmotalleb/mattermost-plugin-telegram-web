{
    "id": "com.telegramweb.ui",
    "name": "Telegram Web UI",
    "description": "Replaces the Mattermost web app UI with a Telegram Web style client. Chats, contacts, groups, custom groups and the chat screen are rendered from your existing Mattermost data (channels, DMs, group messages, channel categories, teams).",
    "homepage_url": "https://github.com/example/mattermost-plugin-telegram-web",
    "support_url": "https://github.com/example/mattermost-plugin-telegram-web/issues",
    "release_notes_url": "https://github.com/example/mattermost-plugin-telegram-web/releases",
    "icon_path": "assets/icon.svg",
    "version": "0.4.2",
    "min_server_version": "12.0.0",
    "webapp": {
        "bundle_path": "webapp/dist/main.js"
    },
    "server": {
        "executables": {
            "linux-amd64": "server/dist/plugin-linux-amd64",
            "linux-arm64": "server/dist/plugin-linux-arm64"
        }
    },
    "settings_schema": {
        "header": "Server side defaults for the Telegram Web UI plugin. Users can override these in the plugin's own settings screen inside the UI.",
        "footer": "* These settings only provide defaults. They are read from the web app through the client config.",
        "settings": [
            {
                "key": "DefaultMode",
                "display_name": "Enable Telegram Web UI by default",
                "type": "bool",
                "help_text": "When true, the Telegram Web UI is active for every user as soon as the page loads.",
                "default": false
            },
            {
                "key": "DefaultTheme",
                "display_name": "Default theme",
                "type": "dropdown",
                "help_text": "Default theme for users that did not pick one yet.",
                "default": "light",
                "options": [
                    {
                        "display_name": "Light",
                        "value": "light"
                    },
                    {
                        "display_name": "Dark",
                        "value": "dark"
                    },
                    {
                        "display_name": "Tinted",
                        "value": "tinted"
                    },
                    {
                        "display_name": "Ice",
                        "value": "ice"
                    },
                    {
                        "display_name": "Midnight",
                        "value": "midnight"
                    }
                ]
            },
            {
                "key": "DefaultAccent",
                "display_name": "Default accent color",
                "type": "dropdown",
                "help_text": "Accent color used for buttons, links and outgoing message bubbles.",
                "default": "blue",
                "options": [
                    {
                        "display_name": "Blue",
                        "value": "blue"
                    },
                    {
                        "display_name": "Violet",
                        "value": "violet"
                    },
                    {
                        "display_name": "Green",
                        "value": "green"
                    },
                    {
                        "display_name": "Orange",
                        "value": "orange"
                    },
                    {
                        "display_name": "Red",
                        "value": "red"
                    }
                ]
            },
            {
                "key": "DefaultWallpaper",
                "display_name": "Default chat background",
                "type": "dropdown",
                "help_text": "Default chat wallpaper pattern for users that did not pick one yet.",
                "default": "doodles",
                "options": [
                    {
                        "display_name": "Doodles",
                        "value": "doodles"
                    },
                    {
                        "display_name": "Plain",
                        "value": "none"
                    },
                    {
                        "display_name": "Dots",
                        "value": "dots"
                    },
                    {
                        "display_name": "Grid",
                        "value": "grid"
                    },
                    {
                        "display_name": "Checker",
                        "value": "checker"
                    },
                    {
                        "display_name": "Diagonal",
                        "value": "diagonal"
                    }
                ]
            },
            {
                "key": "DefaultGlassyMode",
                "display_name": "Default glassy translucent panels",
                "type": "bool",
                "help_text": "Default for the translucent, blurred chrome (panels, header, composer).",
                "default": true
            },
            {
                "key": "DefaultCompactMode",
                "display_name": "Default compact mode",
                "type": "bool",
                "help_text": "Default for the tighter chat list and message spacing.",
                "default": false
            },
            {
                "key": "DefaultAnimations",
                "display_name": "Default animations",
                "type": "bool",
                "help_text": "Default for interface animations (spinners, transitions, the header gloss).",
                "default": true
            },
            {
                "key": "DefaultJalali",
                "display_name": "Use Jalali (Solar Hijri) dates by default",
                "type": "bool",
                "help_text": "When true, dates across the UI (date separators, message stamps, chat list times) are shown in the Jalali calendar by default. Every user can switch it on or off for themselves in the plugin's own settings.",
                "default": true
            }
        ]
    }
}
